{
  "name": "hpl-tsc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "hpl-tsc": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "libhpl.d.ts",
    "libminecraftne.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "catalog": "node scripts/generate-catalog.mjs",
    "catalog:check": "node scripts/generate-catalog.mjs --check",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run catalog:check && npm run build && node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "5.8.3"
  }
}
